<mah:MetroWindow x:Class="Forza_Mods_AIO.Views.Windows.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:local="clr-namespace:Forza_Mods_AIO.Views.Windows"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance local:MainWindow,IsDesignTimeCreatable=True}"
                 Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
                 Height="800"
                 Width="760"
                 MinHeight="800"
                 MinWidth="760"
                 ShowTitleBar="False"
                 ShowCloseButton="False"
                 ShowMinButton="False"
                 ShowMaxRestoreButton="False"
                 BorderThickness="0"
                 AllowsTransparency="True"
                 Background="Transparent"
                 WindowStyle="None"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterScreen"
                 MouseDown="MainWindow_OnMouseDown">

    <mah:MetroWindow.Resources>
        <SolidColorBrush x:Key="NeonPurple" Color="#B14CFF"/>
        <SolidColorBrush x:Key="PanelBlack" Color="#08070D"/>
        <SolidColorBrush x:Key="MutedText" Color="#A79AB8"/>

        <Style x:Key="ChromeButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#EDE6FF"/>
            <Setter Property="Background" Value="#171225"/>
            <Setter Property="BorderBrush" Value="#3B205A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="4 0 0 0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </mah:MetroWindow.Resources>

    <Border CornerRadius="18" Background="#050409" BorderBrush="#3B145C" BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.70" Color="#7A16C9"/>
        </Border.Effect>

        <Grid>
            <Grid.Background>
                <RadialGradientBrush Center="0.04,0.02" GradientOrigin="0.04,0.02" RadiusX="1.15" RadiusY="1.15">
                    <GradientStop Color="#241038" Offset="0"/>
                    <GradientStop Color="#09060F" Offset="0.50"/>
                    <GradientStop Color="#030205" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0A0710" CornerRadius="18 18 0 0" BorderBrush="#231238" BorderThickness="0 0 0 1">
                <Grid Margin="18 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FH6 BOOSTER"
                                   Foreground="#F2E7FF"
                                   FontFamily="Consolas"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="By Vynx.dev"
                                   Foreground="{StaticResource MutedText}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Margin="1 2 0 0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#130B1F" BorderBrush="#4C2277" BorderThickness="1" CornerRadius="12" Padding="10 5" Margin="0 0 12 0">
                            <TextBlock Text="{Binding ViewModel.AttachedText, Mode=OneWay}"
                                       Foreground="#C6A6FF"
                                       FontFamily="Consolas"
                                       FontSize="10.5"/>
                        </Border>

                        <Button Tag="1" Content="-" Style="{StaticResource ChromeButton}" Click="WindowStateAction_OnClick"/>
                        <Button Tag="2" Content="[]" Style="{StaticResource ChromeButton}" Click="WindowStateAction_OnClick"/>
                        <Button Tag="3" Content="X" Style="{StaticResource ChromeButton}" Click="WindowStateAction_OnClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="18 14 18 12" CornerRadius="16" Background="#0B0812" BorderBrush="#2F164B" BorderThickness="1">
                <Frame NavigationUIVisibility="Hidden"
                       Background="Transparent"
                       Content="{Binding ViewModel.CurrentView}"/>
            </Border>

            <Border Grid.Row="2" CornerRadius="0 0 18 18" Background="#07050B" BorderBrush="#231238" BorderThickness="0 1 0 0">
                <Grid Margin="18 0">
                    <TextBlock Text="Vynx.dev"
                               Foreground="#B14CFF"
                               FontFamily="Consolas"
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Cursor="Hand"
                               MouseLeftButtonUp="VynxFooter_OnMouseLeftButtonUp"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</mah:MetroWindow>


