<Page x:Class="Forza_Mods_AIO.Views.SubPages.SelfVehicle.Unlocks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:local="clr-namespace:Forza_Mods_AIO.Views.SubPages.SelfVehicle"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:Unlocks, IsDesignTimeCreatable=true}"
      Title="Unlocks"
      Background="Transparent"
      d:DesignHeight="260"
      d:DesignWidth="500">

    <Page.Resources>
        <SolidColorBrush x:Key="BoosterPurple" Color="#B14CFF"/>
        <SolidColorBrush x:Key="BoosterPanel" Color="#0F0A18"/>
        <SolidColorBrush x:Key="BoosterField" Color="#171025"/>
        <SolidColorBrush x:Key="BoosterBorder" Color="#4E2478"/>
        <SolidColorBrush x:Key="BoosterMuted" Color="#9587A8"/>

        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource BoosterMuted}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0 0 0 6"/>
        </Style>

        <Style x:Key="ToolButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0 0 8 8"/>
            <Setter Property="Foreground" Value="#F2E7FF"/>
            <Setter Property="Background" Value="{StaticResource BoosterField}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BoosterBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsEnabled" Value="{Binding ToolViewModel.UiElementsEnabled}"/>
            <Setter Property="mah:ControlsHelper.CornerRadius" Value="9"/>
            <Setter Property="mah:ControlsHelper.FocusBorderThickness" Value="0"/>
        </Style>
    </Page.Resources>

    <TabControl Margin="18"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#F2E7FF"
                FontFamily="Consolas">
        <TabItem Header="VALUE OVERRIDE">
            <Grid Margin="0 12 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="MODULE" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="UnlockBox"
                              SelectedIndex="0"
                              SelectionChanged="UnlockBox_OnSelectionChanged"
                              IsEnabled="{Binding ViewModel.AreUiElementsEnabled}"
                              Height="40"
                              FontFamily="Consolas"
                              Foreground="#F2E7FF"
                              Background="{StaticResource BoosterField}"
                              BorderBrush="{StaticResource BoosterBorder}"
                              mah:ControlsHelper.CornerRadius="10">
                        <ComboBoxItem Content="Credits"/>
                        <ComboBoxItem Content="XP"/>
                        <ComboBoxItem Content="Wheelspins"/>
                        <ComboBoxItem Content="Skill Points"/>
                        <ComboBoxItem Content="Accolades"/>
                        <ComboBoxItem Content="Kudos"/>
                        <ComboBoxItem Content="Forzathon Points"/>
                        <ComboBoxItem Content="Series Points"/>
                        <ComboBoxItem Content="Seasonal Points"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="AMOUNT" Style="{StaticResource FieldLabel}"/>
                    <mah:NumericUpDown x:Name="ValueBox"
                                       IsEnabled="{Binding ViewModel.AreUiElementsEnabled}"
                                       Height="40"
                                       TextAlignment="Left"
                                       Value="0"
                                       ParsingNumberStyle="Integer"
                                       Minimum="0"
                                       Maximum="2147483647"
                                       ValueChanged="ValueBox_OnValueChanged"
                                       HideUpDownButtons="True"
                                       FontFamily="Consolas"
                                       Foreground="#F2E7FF"
                                       Background="{StaticResource BoosterField}"
                                       BorderBrush="{StaticResource BoosterBorder}"
                                       mah:ControlsHelper.CornerRadius="10"/>
                </StackPanel>

                <Border Grid.Row="4"
                        CornerRadius="12"
                        Background="#130A20"
                        BorderBrush="#6A2CA8"
                        BorderThickness="1"
                        Padding="13 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="VALUE OVERRIDE"
                                       Foreground="#EEDFFF"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       FontSize="13"/>
                            <TextBlock Text="Enable after setting amount.&#x0a;Do something to update the value you want to change in game.&#x0a;Disable after it changes in game."
                                       Foreground="{StaticResource BoosterMuted}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0 5 18 0"/>
                        </StackPanel>

                        <mah:ToggleSwitch x:Name="UnlockSwitch"
                                          Grid.Column="1"
                                          IsEnabled="{Binding ViewModel.AreUiElementsEnabled}"
                                          VerticalAlignment="Center"
                                          MinWidth="0"
                                          FontSize="12"
                                          Toggled="UnlockSwitch_OnToggled"/>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="FH6 TOOLS">
            <ScrollViewer Margin="0 12 0 0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Safe add-on actions from FH6 All-in-One. These do not change the Credits override flow."
                               Foreground="{StaticResource BoosterMuted}"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0 0 0 10"/>

                    <UniformGrid Columns="2">
                        <Button Content="Install Flags"
                                Style="{StaticResource ToolButton}"
                                Command="{Binding ToolViewModel.ExecuteSqlCommand}"
                                CommandParameter="{Binding ToolViewModel.InstallFlagsSql}"/>
                        <Button Content="Full Autoshow"
                                Style="{StaticResource ToolButton}"
                                Command="{Binding ToolViewModel.ExecuteSqlCommand}"
                                CommandParameter="{Binding ToolViewModel.FullAutoshowSql}"/>
                        <Button Content="Free All Upgrades"
                                Style="{StaticResource ToolButton}"
                                Command="{Binding ToolViewModel.ExecuteSqlCommand}"
                                CommandParameter="{Binding ToolViewModel.FreeAllUpgradesSql}"/>
                        <Button Content="Free Wheels"
                                Style="{StaticResource ToolButton}"
                                Command="{Binding ToolViewModel.ExecuteSqlCommand}"
                                CommandParameter="{Binding ToolViewModel.FreeWheelsSql}"/>
                        <Button Content="Drift Score 10x"
                                Style="{StaticResource ToolButton}"
                                Command="{Binding ToolViewModel.ExecuteSqlCommand}"
                                CommandParameter="{Binding ToolViewModel.DriftScoreSql}"/>
                        <Button Content="Max Traction"
                                Style="{StaticResource ToolButton}"
                                Command="{Binding ToolViewModel.ExecuteSqlCommand}"
                                CommandParameter="{Binding ToolViewModel.MaxTractionSql}"/>
                        <Button Content="Torque 2x"
                                Style="{StaticResource ToolButton}"
                                Command="{Binding ToolViewModel.ExecuteSqlCommand}"
                                CommandParameter="{Binding ToolViewModel.TorqueScaleSql}"/>
                        <Button Content="Drag 0.5x"
                                Style="{StaticResource ToolButton}"
                                Command="{Binding ToolViewModel.ExecuteSqlCommand}"
                                CommandParameter="{Binding ToolViewModel.DragScaleSql}"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Page>
